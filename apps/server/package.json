    "node-cs2": "^2.7.1",
    "qrcode": "^1.5.4",
    "steam-session": "^1.9.4",
    "steam-totp": "^2.1.2",
    "steam-user": "^5.3.0",
    "unbzip2-stream": "^1.4.3",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.1",
    "@types/qrcode": "^1.5.6",
    "@types/steam-totp": "^2.1.2",
    "@types/steam-user": "^5.1.1",
