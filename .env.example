# ── Server ────────────────────────────────────────────────────────────────
PORT=8787
HOST=127.0.0.1
LOG_LEVEL=info

# SQLite lives outside the repo in production; local default is fine.
# GIGA_DB=C:\data\giga.db

# Demo mode serves a synthetic 24-match dataset and marks the UI as DEMO.
# Set to 0 only after the Steam/GC pipeline has produced real matches.
GIGA_DEMO=1

# ── Steam (worker is opt-in; do not commit real values) ───────────────────
STEAM_SYNC=0
STEAM_AUTOSTART=1
STEAM_ID=
STEAM_API_KEY=
STEAM_ACCOUNT_NAME=
# Prefer a refresh token over a password once the login flow exists.
STEAM_REFRESH_TOKEN=
# Optional: shared_secret for mobile Steam Guard TOTP.
STEAM_SHARED_SECRET=

# ── Public access ─────────────────────────────────────────────────────────
# Enable Basic Auth before exposing the app through any tunnel or VM.
APP_USER=
APP_PASSWORD=
PUBLIC_ORIGIN=http://127.0.0.1:8787
